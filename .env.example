# Postgres. Leave unset to run the app in demo mode against an in-memory
# catalogue of 2,400 restaurants — everything works, nothing persists.
# In production point this at the transaction-mode pooler, not the database port.
DATABASE_URL=postgres://user:pass@localhost:5432/yourdiningclub
PG_POOL_MAX=8

# Signs the session cookie. Rotate by deploying a new value; all sessions
# invalidate at once, which is the intended behaviour for a compromised key.
SESSION_SECRET=change-me-to-32-plus-random-bytes

# Stripe. Without these, /join activates a local membership so the member
# journey stays walkable in a demo.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Unsplash. Only needed to refill missing category photography; the manifest at
# src/data/images.json is committed, so the app runs without this key.
UNSPLASH_ACCESS_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
